package web

templ Dashboard(username string, posts []PostRow) {
	@Layout("Dashboard") {
		@Nav(username)
		<div class="max-w-5xl mx-auto px-6 py-8">
			<div class="flex justify-between items-center mb-6">
				<h1 class="text-2xl font-bold">Posts</h1>
				<a href="/admin/posts/new" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded">
					+ Nuevo post
				</a>
			</div>
			<div class="bg-white rounded-xl shadow overflow-hidden">
				<table class="w-full">
					<thead>
						<tr class="border-b border-gray-200">
							<th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-6 py-3">Título</th>
							<th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-6 py-3">Categorías</th>
							<th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-6 py-3">Fecha</th>
							<th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-6 py-3">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range posts {
							@dashboardRow(p)
						}
						if len(posts) == 0 {
							<tr>
								<td colspan="4" class="text-center text-gray-400 py-10">No hay posts todavía</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

templ dashboardRow(p PostRow) {
	<tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50">
		<td class="px-6 py-4 font-medium">{ p.Title }</td>
		<td class="px-6 py-4 text-sm text-gray-600">{ p.Categories }</td>
		<td class="px-6 py-4 text-sm text-gray-500">{ p.Date }</td>
		<td class="px-6 py-4">
			<div class="flex gap-2">
				<a
					href={ templ.SafeURL("/admin/posts/" + p.ID.String() + "/edit") }
					class="bg-gray-500 hover:bg-gray-600 text-white text-xs font-medium px-3 py-1.5 rounded"
				>
					Editar
				</a>
				<form
					method="POST"
					action={ templ.SafeURL("/admin/posts/" + p.ID.String() + "/delete") }
					onsubmit="return confirm('¿Eliminar este post?')"
				>
					<button type="submit" class="bg-red-600 hover:bg-red-700 text-white text-xs font-medium px-3 py-1.5 rounded cursor-pointer">
						Eliminar
					</button>
				</form>
			</div>
		</td>
	</tr>
}

