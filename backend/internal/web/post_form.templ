package web

templ PostForm(username string, form PostFormData) {
	@Layout(formTitle(form)) {
		@Nav(username)
		<div class="max-w-3xl mx-auto px-6 py-8">
			<div class="flex items-center gap-3 mb-6">
				<a href="/admin/" class="text-gray-400 hover:text-gray-600 text-sm">← Volver</a>
				<h1 class="text-2xl font-bold">{ formTitle(form) }</h1>
			</div>
			if form.Error != "" {
				<div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-6">
					{ form.Error }
				</div>
			}
			<form method="POST" action={ templ.SafeURL(formAction(form)) }>
				<!-- Post metadata -->
				<div class="bg-white rounded-xl shadow p-6 mb-6">
					<h2 class="text-base font-semibold text-gray-700 mb-4">Datos del post</h2>
					<div class="mb-4">
						<label class="block text-sm font-semibold text-gray-700 mb-1" for="title">Título</label>
						<input
							id="title"
							name="title"
							type="text"
							value={ form.Title }
							required
							class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
						/>
					</div>
					<div class="mb-4">
						<label class="block text-sm font-semibold text-gray-700 mb-1" for="subtitle">Subtítulo</label>
						<input
							id="subtitle"
							name="subtitle"
							type="text"
							value={ form.Subtitle }
							class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
						/>
					</div>
					<div class="grid grid-cols-2 gap-4 mb-4">
						<div>
							<label class="block text-sm font-semibold text-gray-700 mb-1" for="date">Fecha</label>
							<input
								id="date"
								name="date"
								type="date"
								value={ form.Date }
								required
								class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
							/>
						</div>
						<div>
							<label class="block text-sm font-semibold text-gray-700 mb-1" for="slug">Slug</label>
							<input
								id="slug"
								name="slug"
								type="text"
								value={ form.Slug }
								required
								class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
							/>
						</div>
					</div>
					<div class="mb-4">
						<label class="block text-sm font-semibold text-gray-700 mb-1" for="hero_image">Hero image (URL)</label>
						<input
							id="hero_image"
							name="hero_image"
							type="url"
							value={ form.HeroImage }
							placeholder="https://..."
							class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
						/>
					</div>
					<div>
						<label class="block text-sm font-semibold text-gray-700 mb-1" for="categories">
							Categorías <span class="text-gray-400 font-normal">(separadas por coma)</span>
						</label>
						<input
							id="categories"
							name="categories"
							type="text"
							value={ form.Categories }
							placeholder="Go, Linux, Cloud"
							class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
						/>
					</div>
				</div>
				<!-- Block editor -->
				<div class="bg-white rounded-xl shadow p-6 mb-6">
					<h2 class="text-base font-semibold text-gray-700 mb-4">Contenido</h2>
					<!-- Add block buttons -->
					<div class="flex flex-wrap gap-2 mb-4 items-center">
						<span class="text-sm text-gray-400">Añadir bloque:</span>
						<button type="button" onclick="addBlock('p')" class="bg-violet-100 hover:bg-violet-200 text-violet-800 text-xs font-semibold px-3 py-1.5 rounded cursor-pointer">
							+ Párrafo
						</button>
						<button type="button" onclick="addBlock('c')" class="bg-cyan-100 hover:bg-cyan-200 text-cyan-800 text-xs font-semibold px-3 py-1.5 rounded cursor-pointer">
							+ Código
						</button>
						<button type="button" onclick="addBlock('i')" class="bg-green-100 hover:bg-green-200 text-green-800 text-xs font-semibold px-3 py-1.5 rounded cursor-pointer">
							+ Imagen
						</button>
						<button type="button" onclick="addBlock('t')" class="bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-semibold px-3 py-1.5 rounded cursor-pointer">
							+ Tabla
						</button>
					</div>
					<!-- Existing blocks -->
					<div id="blocks-container">
						for _, b := range form.Blocks {
							switch b.Type {
								case "p":
									@BlockParagraph(b)
								case "c":
									@BlockCode(b)
								case "i":
									@BlockImage(b)
								case "t":
									@BlockTable(b)
							}
						}
					</div>
					<input type="hidden" id="block_order" name="block_order" value={ form.InitialBlockOrder }/>
				</div>
				<!-- Actions -->
				<div class="flex gap-3">
					<button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2 rounded cursor-pointer">
						if form.IsNew {
							Crear post
						} else {
							Guardar cambios
						}
					</button>
					<a href="/admin/" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-6 py-2 rounded">
						Cancelar
					</a>
				</div>
			</form>
		</div>
		<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
		<script>
			async function addBlock(type) {
				try {
					const res = await fetch('/admin/blocks/fragment/' + type);
					if (!res.ok) throw new Error('Error al cargar bloque');
					const html = await res.text();
					const tpl = document.createElement('template');
					tpl.innerHTML = html.trim();
					const node = tpl.content.firstElementChild;
					document.getElementById('blocks-container').appendChild(node);
					updateBlockOrder();
					const blockId = node.dataset.blockId;
					if (type === 't' && blockId) initColStyles(blockId, '[]');
					if (type === 'p' && blockId) applyParagraphPreview(blockId);
				} catch (e) {
					console.error(e);
					alert('No se pudo añadir el bloque');
				}
			}

			function updateBlockOrder() {
				const cards = document.querySelectorAll('#blocks-container [data-block-id]');
				const ids = [...cards].map(c => c.dataset.blockId);
				document.getElementById('block_order').value = ids.join(',');
			}

			document.addEventListener('click', function(e) {
				const btn = e.target.closest('.remove-block-btn');
				if (!btn) return;
				const card = btn.closest('[data-block-id]');
				if (card) {
					card.remove();
					updateBlockOrder();
				}
			});

			// Drag & drop reordering
			Sortable.create(document.getElementById('blocks-container'), {
				handle: '.drag-handle',
				animation: 150,
				ghostClass: 'opacity-40',
				onEnd: updateBlockOrder,
			});

			// Ensure block_order is in sync on load (edit page)
			updateBlockOrder();

			// ── Column style editor ──────────────────────────────────────────
			const COL_STYLES = ['size-lg', 'size-md', 'size-xs', 'bold', 'italic', 'underline'];

			function createColStyleRow(blockId, col) {
				// col = { header: string|number, style: string[], colored_numbers?: bool }
				const row = document.createElement('div');
				row.className = 'flex flex-wrap items-center gap-2 bg-white border border-gray-200 rounded px-3 py-2';
				row.dataset.colRow = '1';

				const headerInput = document.createElement('input');
				headerInput.type = 'text';
				headerInput.placeholder = 'Columna (nº o nombre)';
				headerInput.value = col.header !== undefined ? String(col.header) : '';
				headerInput.className = 'border border-gray-300 rounded px-2 py-1 text-xs w-32 focus:outline-none focus:ring-1 focus:ring-amber-400';
				headerInput.dataset.colHeader = '1';
				row.appendChild(headerInput);

				for (const s of COL_STYLES) {
					const lbl = document.createElement('label');
					lbl.className = 'flex items-center gap-1 text-xs cursor-pointer';

					const cb = document.createElement('input');
					cb.type = 'checkbox';
					cb.value = s;
					cb.dataset.colStyle = '1';
					if (col.style && col.style.includes(s)) cb.checked = true;

					lbl.appendChild(cb);
					lbl.appendChild(document.createTextNode(s));
					row.appendChild(lbl);
				}

				const coloredLbl = document.createElement('label');
				coloredLbl.className = 'flex items-center gap-1 text-xs cursor-pointer';
				const coloredCb = document.createElement('input');
				coloredCb.type = 'checkbox';
				coloredCb.dataset.colColored = '1';
				if (col.colored_numbers) coloredCb.checked = true;
				coloredLbl.appendChild(coloredCb);
				coloredLbl.appendChild(document.createTextNode('colored_numbers'));
				row.appendChild(coloredLbl);

				const removeBtn = document.createElement('button');
				removeBtn.type = 'button';
				removeBtn.className = 'remove-col-style-btn ml-auto text-red-400 hover:text-red-600 text-xs font-bold cursor-pointer';
				removeBtn.dataset.blockId = blockId;
				removeBtn.textContent = '✕';
				row.appendChild(removeBtn);

				return row;
			}

			function initColStyles(blockId, jsonStr) {
				const container = document.getElementById('col-styles-' + blockId);
				if (!container) return;
				container.innerHTML = '';
				let cols = [];
				try { cols = JSON.parse(jsonStr || '[]'); } catch (_) {}
				for (const col of cols) {
					container.appendChild(createColStyleRow(blockId, col));
				}
			}

			function addColStyleRow(blockId) {
				const container = document.getElementById('col-styles-' + blockId);
				if (!container) return;
				container.appendChild(createColStyleRow(blockId, { header: '', style: [] }));
			}

			function serializeColStyles(blockId) {
				const container = document.getElementById('col-styles-' + blockId);
				const hidden = document.getElementById('t_col_style_' + blockId);
				if (!container || !hidden) return;
				const rows = container.querySelectorAll('[data-col-row]');
				const result = [];
				for (const row of rows) {
					const header = row.querySelector('[data-col-header]').value.trim();
					const styles = [...row.querySelectorAll('[data-col-style]:checked')].map(cb => cb.value);
					const colored = row.querySelector('[data-col-colored]').checked;
					const col = { header: isNaN(Number(header)) || header === '' ? header : Number(header), style: styles };
					if (colored) col.colored_numbers = true;
					result.push(col);
				}
				hidden.value = JSON.stringify(result);
			}

			// Event delegation — "Añadir columna" buttons
			document.addEventListener('click', function(e) {
				const addBtn = e.target.closest('.add-col-style-btn');
				if (addBtn) {
					addColStyleRow(addBtn.dataset.blockId);
					return;
				}
				const removeBtn = e.target.closest('.remove-col-style-btn');
				if (removeBtn) {
					const row = removeBtn.closest('[data-col-row]');
					if (row) row.remove();
				}
			});

			// Serialize column styles for all table blocks before form submit
			document.querySelector('form').addEventListener('submit', function() {
				document.querySelectorAll('[id^="col-styles-"]').forEach(function(el) {
					const blockId = el.id.replace('col-styles-', '');
					serializeColStyles(blockId);
				});
			});

			// Initialize existing table blocks on page load
			document.querySelectorAll('[id^="col-styles-"]').forEach(function(el) {
				const blockId = el.id.replace('col-styles-', '');
				const hidden = document.getElementById('t_col_style_' + blockId);
				if (hidden) initColStyles(blockId, hidden.value);
			});

			// ── Paragraph style preview ──────────────────────────────────────
			// Maps style name → CSS properties to apply to the textarea
			const PARAGRAPH_STYLE_CSS = {
				'bold':      { fontWeight: 'bold' },
				'italic':    { fontStyle: 'italic' },
				'underline': { textDecoration: 'underline' },
				'size-lg':   { fontSize: '1.125rem' },
			};
			// color-* styles use custom theme tokens unavailable in the admin;
			// we approximate them with a colored left border on the textarea.
			const PARAGRAPH_COLOR_BORDER = {
				'color-1': '#6366f1', // indigo (primary)
				'color-2': '#8b5cf6', // violet (secondary)
				'color-3': '#ec4899', // pink (third)
			};

			function applyParagraphPreview(blockId) {
				const block = document.getElementById('block-' + blockId);
				if (!block) return;
				const textarea = block.querySelector('textarea[name="p_text_' + blockId + '"]');
				if (!textarea) return;

				const checked = [...block.querySelectorAll('input[name="p_conf_' + blockId + '"]:checked')]
					.map(cb => cb.value);

				// Reset all preview styles
				Object.assign(textarea.style, {
					fontWeight: '',
					fontStyle: '',
					textDecoration: '',
					fontSize: '',
					borderLeftWidth: '',
					borderLeftColor: '',
					borderLeftStyle: '',
				});

				let colorStyle = null;
				for (const style of checked) {
					if (PARAGRAPH_STYLE_CSS[style]) {
						Object.assign(textarea.style, PARAGRAPH_STYLE_CSS[style]);
					}
					if (PARAGRAPH_COLOR_BORDER[style]) {
						colorStyle = PARAGRAPH_COLOR_BORDER[style];
					}
				}
				if (colorStyle) {
					textarea.style.borderLeftWidth = '4px';
					textarea.style.borderLeftStyle = 'solid';
					textarea.style.borderLeftColor = colorStyle;
				}
			}

			// Listen for style checkbox changes inside paragraph blocks
			document.addEventListener('change', function(e) {
				const cb = e.target.closest('input[type="checkbox"]');
				if (!cb) return;
				const nameAttr = cb.getAttribute('name') || '';
				if (!nameAttr.startsWith('p_conf_')) return;
				const blockId = nameAttr.replace('p_conf_', '');
				applyParagraphPreview(blockId);
			});

			// Initialize preview for existing paragraph blocks on page load (edit page)
			document.querySelectorAll('[id^="block-"]').forEach(function(el) {
				const blockId = el.id.replace('block-', '');
				// Only act on paragraph blocks (they have a p_text_ textarea)
				if (el.querySelector('textarea[name="p_text_' + blockId + '"]')) {
					applyParagraphPreview(blockId);
				}
			});
		</script>
	}
}

func formTitle(form PostFormData) string {
	if form.IsNew {
		return "Nuevo post"
	}
	return "Editar post"
}

func formAction(form PostFormData) string {
	if form.IsNew {
		return "/admin/posts"
	}
	return "/admin/posts/" + form.PostID
}
