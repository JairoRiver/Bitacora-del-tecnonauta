package web

// blockChecked returns true if val is present in list.
func blockChecked(list []string, val string) bool {
	for _, v := range list {
		if v == val {
			return true
		}
	}
	return false
}

templ BlockParagraph(b BlockFormData) {
	<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" id={ "block-" + b.ID } data-block-id={ b.ID }>
		<input type="hidden" name={ "block_type_" + b.ID } value="p"/>
		<div class="flex justify-between items-center mb-3">
			<span class="bg-violet-600 text-white text-xs font-bold px-2 py-0.5 rounded">Párrafo</span>
			<button
				type="button"
				class="remove-block-btn text-red-500 hover:text-red-700 text-sm font-bold cursor-pointer"
				data-block-id={ b.ID }
			>✕ Eliminar</button>
		</div>
		<div class="mb-3">
			<label class="block text-sm font-semibold text-gray-700 mb-1">Texto</label>
			<textarea
				name={ "p_text_" + b.ID }
				rows="4"
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
			>{ b.ParagraphText }</textarea>
		</div>
		<div>
			<label class="block text-sm font-semibold text-gray-700 mb-2">Estilos</label>
			<div class="flex flex-wrap gap-3">
				for _, style := range []string{"size-lg", "bold", "italic", "underline", "color-1", "color-2", "color-3"} {
					<label class="flex items-center gap-1 text-sm cursor-pointer">
						<input
							type="checkbox"
							name={ "p_conf_" + b.ID }
							value={ style }
							if blockChecked(b.ParagraphConf, style) {
								checked
							}
						/>
						{ style }
					</label>
				}
			</div>
		</div>
	</div>
}

templ BlockCode(b BlockFormData) {
	<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" id={ "block-" + b.ID } data-block-id={ b.ID }>
		<input type="hidden" name={ "block_type_" + b.ID } value="c"/>
		<div class="flex justify-between items-center mb-3">
			<span class="bg-cyan-600 text-white text-xs font-bold px-2 py-0.5 rounded">Código</span>
			<button
				type="button"
				class="remove-block-btn text-red-500 hover:text-red-700 text-sm font-bold cursor-pointer"
				data-block-id={ b.ID }
			>✕ Eliminar</button>
		</div>
		<div class="grid grid-cols-2 gap-4 mb-3">
			<div>
				<label class="block text-sm font-semibold text-gray-700 mb-1">Lenguaje</label>
				<select
					name={ "c_lang_" + b.ID }
					class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
				>
					for _, lang := range []string{"SQL", "TypeScript", "Go", "Python", "Rust"} {
						<option
							value={ lang }
							if b.CodeLanguage == lang {
								selected
							}
						>{ lang }</option>
					}
				</select>
			</div>
			<div>
				<label class="block text-sm font-semibold text-gray-700 mb-1">Estilo</label>
				<select
					name={ "c_style_" + b.ID }
					class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
				>
					for _, s := range []string{"color-1", "color-2", "color-3"} {
						<option
							value={ s }
							if b.CodeStyle == s {
								selected
							}
						>{ s }</option>
					}
				</select>
			</div>
		</div>
		<div>
			<label class="block text-sm font-semibold text-gray-700 mb-1">Código</label>
			<textarea
				name={ "c_text_" + b.ID }
				rows="8"
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
			>{ b.CodeText }</textarea>
		</div>
	</div>
}

templ BlockImage(b BlockFormData) {
	<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" id={ "block-" + b.ID } data-block-id={ b.ID }>
		<input type="hidden" name={ "block_type_" + b.ID } value="i"/>
		<div class="flex justify-between items-center mb-3">
			<span class="bg-green-600 text-white text-xs font-bold px-2 py-0.5 rounded">Imagen</span>
			<button
				type="button"
				class="remove-block-btn text-red-500 hover:text-red-700 text-sm font-bold cursor-pointer"
				data-block-id={ b.ID }
			>✕ Eliminar</button>
		</div>
		<div class="mb-3">
			<label class="block text-sm font-semibold text-gray-700 mb-1">URL de imagen</label>
			<input
				type="url"
				name={ "i_src_" + b.ID }
				value={ b.ImageSrc }
				placeholder="https://..."
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
			/>
		</div>
		<div>
			<label class="block text-sm font-semibold text-gray-700 mb-1">Pie de foto</label>
			<input
				type="text"
				name={ "i_caption_" + b.ID }
				value={ b.ImageCaption }
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
			/>
		</div>
	</div>
}

templ BlockTable(b BlockFormData) {
	<div class="border border-gray-200 rounded-lg p-4 mb-3 bg-gray-50" id={ "block-" + b.ID } data-block-id={ b.ID }>
		<input type="hidden" name={ "block_type_" + b.ID } value="t"/>
		<div class="flex justify-between items-center mb-3">
			<span class="bg-amber-600 text-white text-xs font-bold px-2 py-0.5 rounded">Tabla</span>
			<button
				type="button"
				class="remove-block-btn text-red-500 hover:text-red-700 text-sm font-bold cursor-pointer"
				data-block-id={ b.ID }
			>✕ Eliminar</button>
		</div>
		<div class="mb-3">
			<label class="flex items-center gap-2 text-sm font-semibold text-gray-700 cursor-pointer">
				<input
					type="checkbox"
					name={ "t_has_header_" + b.ID }
					if b.TableHasHeader {
						checked
					}
				/>
				Primera fila es encabezado
			</label>
		</div>
		<div class="mb-3">
			<label class="block text-sm font-semibold text-gray-700 mb-2">Estilos de tabla</label>
			<div class="flex flex-wrap gap-3">
				for _, style := range []string{"size-lg", "size-md", "size-xs", "bold", "italic", "underline"} {
					<label class="flex items-center gap-1 text-sm cursor-pointer">
						<input
							type="checkbox"
							name={ "t_styles_" + b.ID }
							value={ style }
							if blockChecked(b.TableStyles, style) {
								checked
							}
						/>
						{ style }
					</label>
				}
			</div>
		</div>
		<div class="mb-3">
			<label class="block text-sm font-semibold text-gray-700 mb-1">
				Valor — JSON array de arrays
			</label>
			<textarea
				name={ "t_value_" + b.ID }
				rows="6"
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
			>{ b.TableValue }</textarea>
		</div>
		<div>
			<label class="block text-sm font-semibold text-gray-700 mb-1">
				Estilos de columna — JSON <span class="text-gray-400 font-normal">(opcional)</span>
			</label>
			<textarea
				name={ "t_col_style_" + b.ID }
				rows="3"
				class="w-full border border-gray-300 rounded px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
			>{ b.TableColStyle }</textarea>
		</div>
	</div>
}
